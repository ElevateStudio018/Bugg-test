# Settings the Edge Functions read (Supabase dashboard → Edge Functions → Secrets). SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY are provided by Supabase itself.

# E-mail (resend.com): an API key and a sender on a domain verified there.
RESEND_API_KEY=
EMAIL_FROM=Markmontage <noreply@example.se>

# The AI assistant (console.anthropic.com).
ANTHROPIC_API_KEY=

# Rebuilding the site after publishing: a fine-grained GitHub token with "Actions: read and write" on the repository.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=ElevateStudio018/Bugg-test
GITHUB_WORKFLOW=deploy-pages.yml
GITHUB_REF=claude/flottsunds-bygg-site-wptib7

# Where the site and the admin live, for links in e-mails, and which browser origins may call the functions.
SITE_URL=https://elevatestudio018.github.io/Bugg-test
ADMIN_URL=https://elevatestudio018.github.io/Bugg-test/admin
ALLOWED_ORIGINS=https://elevatestudio018.github.io

# The functions' public address, for the approve/deny links in e-mails (normally SUPABASE_URL + /functions/v1).
FUNCTIONS_PUBLIC_URL=

# Elevate Studio's address for credit orders and reset approvals.
AGENCY_EMAIL=elevate.studio018@gmail.com

# Random strings: salt for hashing visitors' addresses, and the key that signs the reset approval links.
IP_HASH_SALT=
RESET_SIGNING_SECRET=
