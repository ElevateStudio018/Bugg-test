# Markmontage BEAB AB on Inleed (Apache or LiteSpeed). Copied to the root of public_html by scripts/build-inleed.mjs.

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# One address for the whole site: https://www.markmontage.se, the same as the canonical links and the sitemap.
# Only the real domain is redirected, so a preview or test address at Inleed is left alone.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # markmontage.se, over http or https → https://www.markmontage.se
  RewriteCond %{HTTP_HOST} ^markmontage\.se$ [NC]
  RewriteRule ^ https://www.markmontage.se%{REQUEST_URI} [R=301,L]

  # http://www.markmontage.se → https. X-Forwarded-Proto keeps it from looping behind a proxy that ends HTTPS.
  RewriteCond %{HTTP_HOST} ^www\.markmontage\.se$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.markmontage.se%{REQUEST_URI} [R=301,L]

  # The certificates moved to the Hållbarhet page.
  RewriteRule ^certifikat/?$ /hallbarhet/ [R=301,L]

  # Addresses from the previous website, still in Google's index, sent to the closest current page so old
  # search results land somewhere real instead of a dead end. Google then replaces them with the new pages.
  RewriteRule ^start/?$ / [R=301,L]
  RewriteRule ^om_oss(/.*)?$ /om-oss/ [R=301,L]
  RewriteRule ^(referenser_1|pagaende-projekt|vara-projekt)(/.*)?$ /projekt/ [R=301,L]
  RewriteRule ^vad_vi_erbjuder_1/?$ / [R=301,L]
  RewriteRule ^(kontakta-oss|kontakta_oss)/?$ /om-oss/ [R=301,L]
  RewriteRule ^jobb/?$ / [R=301,L]
  RewriteRule ^(nyheter|category|author|uncategorized|tag|2017|kunskap-som-ger-trygghet|webbkarta)(/.*)?$ / [R=301,L]
  RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]

  # Old system and WordPress paths that no longer exist → 410 Gone, so search engines drop them quickly.
  # (The admin panel at /admin/ is left alone; only the old /admin/index.php is removed.)
  RewriteRule ^(wp-content|wp-includes|wp-admin|wp-json|content|cache)(/.*)?$ - [G]
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-cron\.php|wp-signup\.php|wp-comments-post\.php|admin/index\.php)$ - [G]
  RewriteRule ^contact-form-7(/.*)?$ - [G]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Pages are checked for changes on every visit; photos, fonts and documents are kept for a while.
# _next/static has its own .htaccess: its file names change with their content, so they are kept for a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 week"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
